# Supabase — preencha com as credenciais do seu projeto (Project Settings > API)
# Depois copie este arquivo para .env.local
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Usada apenas em scripts administrativos no servidor (NUNCA exponha no client).
# Opcional nesta etapa.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# IA (Google Gemini) — usada pelo Assistente de Feedback (somente servidor).
# Tier gratuito. Sem esta chave o assistente mostra um aviso amigável e o
# restante do sistema segue funcionando normalmente.
# Gere em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-gemini-api-key-aqui

# Chave AES-256 (64 hex) que criptografa as senhas do cofre (Operacional > Senhas).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENHAS_CHAVE=

# Notificações push do navegador (gere com: node -e "console.log(require('webpush').generateVAPIDKeys())").
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@empresa.com

# Canva Connect (developer portal > integração > Credentials)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# DISC RH (Configurações > API na DISC RH; só permissões de leitura)
DISCRH_API_KEY=
